<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="theme-color" content="#0A0D0B">
<title>Control Financiero</title>
<style>
  :root{
    --bg:#0A0D0B;
    --panel:#121916;
    --panel2:#0F1512;
    --line:#223028;
    --text:#E7EFE9;
    --muted:#7E9088;
    --pos:#5EEAD4;
    --neg:#FB7185;
    --amber:#FBBF24;
    --radius:14px;
  }
  *{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
  html,body{height:100%;}
  body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family:-apple-system, BlinkMacSystemFont, "SF Pro Text", system-ui, sans-serif;
    padding-bottom:env(safe-area-inset-bottom);
    overscroll-behavior-y:none;
  }
  .num{ font-family: ui-monospace, "SF Mono", "Menlo", monospace; font-variant-numeric: tabular-nums; }

  header{
    padding:calc(env(safe-area-inset-top) + 18px) 20px 10px;
    display:flex; justify-content:space-between; align-items:baseline;
  }
  header h1{
    font-size:13px; letter-spacing:2.5px; text-transform:uppercase;
    color:var(--muted); font-weight:600; margin:0;
  }
  header .mes{
    font-size:12px; color:var(--muted); letter-spacing:1px; text-transform:uppercase;
  }

  .panel{
    margin:6px 16px 16px; padding:22px 18px;
    background:radial-gradient(120% 140% at 10% 0%, #14201B 0%, var(--panel) 55%, var(--panel2) 100%);
    border:1px solid var(--line);
    border-radius:var(--radius);
    position:relative; overflow:hidden;
  }
  .panel::before{
    content:""; position:absolute; inset:0;
    background:repeating-linear-gradient(180deg, rgba(255,255,255,0.015) 0px, rgba(255,255,255,0.015) 1px, transparent 1px, transparent 3px);
    pointer-events:none;
  }
  .saldo-label{ font-size:11px; letter-spacing:2px; color:var(--muted); text-transform:uppercase; }
  .saldo{
    font-size:44px; font-weight:600; margin:4px 0 16px;
    color:var(--pos);
    text-shadow:0 0 18px rgba(94,234,212,0.35);
  }
  .saldo.neg{ color:var(--neg); text-shadow:0 0 18px rgba(251,113,133,0.35); }
  .stats{ display:flex; gap:10px; }
  .stat{ flex:1; background:rgba(255,255,255,0.02); border:1px solid var(--line); border-radius:10px; padding:10px 12px; }
  .stat .l{ font-size:10px; letter-spacing:1.5px; color:var(--muted); text-transform:uppercase; }
  .stat .v{ font-size:18px; margin-top:3px; font-weight:600; }
  .stat.in .v{ color:var(--pos); }
  .stat.out .v{ color:var(--neg); }

  .bars{ display:flex; gap:4px; align-items:flex-end; height:36px; margin-top:16px; }
  .bars .b{ flex:1; background:var(--line); border-radius:3px 3px 0 0; position:relative; min-height:3px; }
  .bars .b.has{ background:linear-gradient(180deg, var(--pos), rgba(94,234,212,0.25)); }

  .actions{ display:flex; gap:10px; padding:0 16px 16px; }
  .actions button{
    flex:1; padding:14px; border-radius:12px; border:1px solid var(--line);
    font-size:14px; font-weight:600; letter-spacing:0.3px;
    background:var(--panel); color:var(--text);
  }
  #btnIn{ color:var(--pos); border-color:rgba(94,234,212,0.3); }
  #btnOut{ color:var(--neg); border-color:rgba(251,113,133,0.3); }

  .listwrap{ padding:0 16px 100px; }
  .daygroup{ margin-bottom:18px; }
  .daylabel{ font-size:11px; letter-spacing:1.5px; text-transform:uppercase; color:var(--muted); margin:0 0 8px 4px; }
  .item{
    display:flex; align-items:center; gap:12px;
    background:var(--panel); border:1px solid var(--line); border-radius:12px;
    padding:12px 14px; margin-bottom:8px;
  }
  .tag{
    width:8px; height:8px; border-radius:50%; flex-shrink:0;
  }
  .item .info{ flex:1; min-width:0; }
  .item .cat{ font-size:14px; font-weight:600; }
  .item .nota{ font-size:12px; color:var(--muted); margin-top:1px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .item .monto{ font-size:15px; font-weight:600; }
  .item .monto.pos{ color:var(--pos); }
  .item .monto.neg{ color:var(--neg); }
  .empty{ text-align:center; color:var(--muted); font-size:13px; padding:40px 20px; }

  .fabbar{
    position:fixed; bottom:calc(14px + env(safe-area-inset-bottom)); left:16px; right:16px;
    display:flex; gap:10px;
  }

  /* Modal */
  .overlay{
    position:fixed; inset:0; background:rgba(0,0,0,0.6); display:none;
    align-items:flex-end; z-index:50;
  }
  .overlay.show{ display:flex; }
  .sheet{
    width:100%; background:var(--panel); border-radius:20px 20px 0 0;
    padding:20px 18px calc(20px + env(safe-area-inset-bottom));
    border-top:1px solid var(--line);
  }
  .sheet h2{ margin:0 0 14px; font-size:16px; }
  .amountRow{ display:flex; align-items:center; justify-content:center; margin:6px 0 18px; }
  .amountRow span{ font-size:20px; color:var(--muted); margin-right:4px; }
  #amount{
    background:transparent; border:none; color:var(--text); font-size:40px; font-weight:600;
    width:200px; text-align:center; outline:none;
  }
  .chips{ display:flex; flex-wrap:wrap; gap:8px; margin-bottom:16px; }
  .chip{
    padding:8px 13px; border-radius:20px; border:1px solid var(--line); font-size:13px;
    background:var(--panel2); color:var(--muted);
  }
  .chip.active{ color:var(--bg); background:var(--amber); border-color:var(--amber); font-weight:600; }
  .field{ margin-bottom:14px; }
  .field label{ font-size:11px; letter-spacing:1px; text-transform:uppercase; color:var(--muted); display:block; margin-bottom:6px; }
  .field input[type=text], .field input[type=date]{
    width:100%; background:var(--panel2); border:1px solid var(--line); border-radius:10px;
    padding:11px 12px; color:var(--text); font-size:14px;
  }
  .sheetActions{ display:flex; gap:10px; margin-top:6px; }
  .sheetActions button{ flex:1; padding:14px; border-radius:12px; border:none; font-size:15px; font-weight:600; }
  #cancelBtn{ background:var(--panel2); color:var(--muted); }
  #saveBtn{ background:var(--pos); color:#062018; }

  .footerlinks{ text-align:center; padding:6px 0 24px; }
  .footerlinks button{
    background:none; border:none; color:var(--muted); font-size:12px; text-decoration:underline;
    padding:6px 10px;
  }
</style>
</head>
<body>

<header>
  <h1>Control Financiero</h1>
  <div class="mes" id="mesLabel"></div>
</header>

<div class="panel">
  <div class="saldo-label">Saldo del mes</div>
  <div class="saldo num" id="saldoTxt">0,00 €</div>
  <div class="stats">
    <div class="stat in"><div class="l">Ingresos</div><div class="v num" id="inTxt">0 €</div></div>
    <div class="stat out"><div class="l">Gastos</div><div class="v num" id="outTxt">0 €</div></div>
  </div>
  <div class="bars" id="bars"></div>
</div>

<div class="actions">
  <button id="btnIn">+ Ingreso</button>
  <button id="btnOut">+ Gasto</button>
</div>

<div class="listwrap" id="list"></div>

<div class="overlay" id="overlay">
  <div class="sheet">
    <h2 id="sheetTitle">Nuevo movimiento</h2>
    <div class="amountRow"><span>€</span><input type="text" inputmode="decimal" id="amount" placeholder="0,00"></div>
    <div class="chips" id="chips"></div>
    <div class="field"><label>Nota (opcional)</label><input type="text" id="nota" placeholder="Ej: cena, gasolina..."></div>
    <div class="field"><label>Fecha</label><input type="date" id="fecha"></div>
    <div class="sheetActions">
      <button id="cancelBtn">Cancelar</button>
      <button id="saveBtn">Guardar</button>
    </div>
  </div>
</div>

<div class="footerlinks">
  <button id="exportBtn">Exportar datos</button>
  <button id="resetBtn">Borrar todo</button>
</div>

<script>
const CATS_IN = ["Nómina","Extra","Ahorro","Otros"];
const CATS_OUT = ["Comida","Transporte","Vivienda","Gimnasio","Ocio","Otros"];
const COLORS = {
  "Nómina":"#5EEAD4","Extra":"#5EEAD4","Ahorro":"#FBBF24",
  "Comida":"#FB7185","Transporte":"#F59E0B","Vivienda":"#F87171",
  "Gimnasio":"#60A5FA","Ocio":"#C084FC","Otros":"#9CA3AF"
};

let movimientos = JSON.parse(localStorage.getItem('cf_movimientos') || '[]');
let modo = 'in';
let catSel = null;

const $ = id => document.getElementById(id);

function fmt(n){
  return n.toLocaleString('es-ES', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €';
}

function mesActualKey(){
  const d = new Date();
  return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0');
}

function render(){
  const mesKey = mesActualKey();
  const delMes = movimientos.filter(m => m.fecha.slice(0,7) === mesKey);
  const ingresos = delMes.filter(m=>m.tipo==='in').reduce((a,m)=>a+m.monto,0);
  const gastos = delMes.filter(m=>m.tipo==='out').reduce((a,m)=>a+m.monto,0);
  const saldo = ingresos - gastos;

  $('saldoTxt').textContent = fmt(saldo);
  $('saldoTxt').classList.toggle('neg', saldo < 0);
  $('inTxt').textContent = fmt(ingresos);
  $('outTxt').textContent = fmt(gastos);

  const meses = ["ENE","FEB","MAR","ABR","MAY","JUN","JUL","AGO","SEP","OCT","NOV","DIC"];
  $('mesLabel').textContent = meses[new Date().getMonth()] + ' ' + new Date().getFullYear();

  // barras últimos 7 días
  const barsEl = $('bars'); barsEl.innerHTML = '';
  let maxDia = 0.01;
  const dias = [];
  for(let i=6;i>=0;i--){
    const d = new Date(); d.setDate(d.getDate()-i);
    const key = d.toISOString().slice(0,10);
    const total = movimientos.filter(m=>m.fecha===key && m.tipo==='out').reduce((a,m)=>a+m.monto,0);
    dias.push(total);
    if(total>maxDia) maxDia = total;
  }
  dias.forEach(v=>{
    const b = document.createElement('div');
    b.className = 'b' + (v>0 ? ' has' : '');
    b.style.height = Math.max(3, (v/maxDia)*36) + 'px';
    barsEl.appendChild(b);
  });

  // lista agrupada por fecha desc
  const listEl = $('list');
  if(movimientos.length === 0){
    listEl.innerHTML = '<div class="empty">Sin movimientos todavía.<br>Pulsa + Ingreso o + Gasto para empezar.</div>';
    return;
  }
  const porFecha = {};
  movimientos.slice().sort((a,b)=> b.fecha.localeCompare(a.fecha) || b.id-a.id)
    .forEach(m=>{ (porFecha[m.fecha] = porFecha[m.fecha]||[]).push(m); });

  listEl.innerHTML = '';
  Object.keys(porFecha).sort().reverse().forEach(fecha=>{
    const grp = document.createElement('div'); grp.className = 'daygroup';
    const dObj = new Date(fecha+'T00:00:00');
    const label = dObj.toLocaleDateString('es-ES', {weekday:'long', day:'numeric', month:'long'});
    grp.innerHTML = `<div class="daylabel">${label}</div>`;
    porFecha[fecha].forEach(m=>{
      const it = document.createElement('div'); it.className='item';
      it.innerHTML = `
        <div class="tag" style="background:${COLORS[m.categoria]||'#888'}"></div>
        <div class="info">
          <div class="cat">${m.categoria}</div>
          ${m.nota ? `<div class="nota">${m.nota}</div>` : ''}
        </div>
        <div class="monto num ${m.tipo==='in'?'pos':'neg'}">${m.tipo==='in'?'+':'-'}${fmt(m.monto)}</div>
      `;
      it.addEventListener('click', ()=>{
        if(confirm('¿Eliminar este movimiento?')){
          movimientos = movimientos.filter(x=>x.id!==m.id);
          guardar(); render();
        }
      });
      grp.appendChild(it);
    });
    listEl.appendChild(grp);
  });
}

function guardar(){
  localStorage.setItem('cf_movimientos', JSON.stringify(movimientos));
}

function abrirSheet(tipo){
  modo = tipo;
  catSel = null;
  $('sheetTitle').textContent = tipo==='in' ? 'Nuevo ingreso' : 'Nuevo gasto';
  $('amount').value = '';
  $('nota').value = '';
  $('fecha').value = new Date().toISOString().slice(0,10);
  const cats = tipo==='in' ? CATS_IN : CATS_OUT;
  const chipsEl = $('chips'); chipsEl.innerHTML = '';
  cats.forEach(c=>{
    const chip = document.createElement('div');
    chip.className = 'chip'; chip.textContent = c;
    chip.addEventListener('click', ()=>{
      catSel = c;
      [...chipsEl.children].forEach(ch=>ch.classList.remove('active'));
      chip.classList.add('active');
    });
    chipsEl.appendChild(chip);
  });
  chipsEl.firstChild.click();
  $('overlay').classList.add('show');
  setTimeout(()=>$('amount').focus(), 200);
}

$('btnIn').addEventListener('click', ()=>abrirSheet('in'));
$('btnOut').addEventListener('click', ()=>abrirSheet('out'));
$('cancelBtn').addEventListener('click', ()=> $('overlay').classList.remove('show'));
$('overlay').addEventListener('click', e=>{ if(e.target.id==='overlay') $('overlay').classList.remove('show'); });

$('saveBtn').addEventListener('click', ()=>{
  const raw = $('amount').value.replace(',', '.').trim();
  const monto = parseFloat(raw);
  if(!monto || monto<=0){ alert('Introduce un importe válido.'); return; }
  if(!catSel){ alert('Elige una categoría.'); return; }
  movimientos.push({
    id: Date.now(),
    tipo: modo,
    monto: monto,
    categoria: catSel,
    nota: $('nota').value.trim(),
    fecha: $('fecha').value || new Date().toISOString().slice(0,10)
  });
  guardar();
  $('overlay').classList.remove('show');
  render();
});

$('exportBtn').addEventListener('click', ()=>{
  const blob = new Blob([JSON.stringify(movimientos, null, 2)], {type:'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = 'control-financiero-datos.json';
  a.click();
});

$('resetBtn').addEventListener('click', ()=>{
  if(confirm('Esto borrará todos tus movimientos guardados. ¿Seguro?')){
    movimientos = [];
    guardar(); render();
  }
});

render();
</script>
</body>
</html>